[import = Moon: "../icons/moon.smark"!]
[import = Sun: "../icons/sun.smark"!]
[import = Github: "../icons/github.smark"!]
[import = Menu: "../icons/menu.smark"!]

[nav = class: "sc-nav"]
  [a = href: "/", class: "sc-logo"]
    [img = src: "/src/assets/som.svg", alt: "SomCheat logo", height: "28"!]
    [span = class: "sc-logo-text"]Somcheat[end:span]
  [end:a]

  [div = class: "sc-nav-actions"]
    [a = href: "https://github.com/Adam-Elmi/SomCheat", target: "_blank", rel: "noopener noreferrer", class: "sc-icon-btn", aria-label: "GitHub"]
      [Github!]
    [end:a]
    [button = id: "theme-toggle", class: "sc-icon-btn", aria-label: "Toggle theme"]
      [span = class: "hide-in-dark"][Moon!][end:span]
      [span = class: "show-in-dark"][Sun!][end:span]
    [end:button]
    [button = id: "menu-toggle", class: "sc-icon-btn sc-menu-btn", aria-label: "Toggle menu", aria-expanded: "false"]
      [Menu!]
    [end:button]
  [end:div]
[end:nav]
