[nav = class: "ck-toc", id: "ck-toc", aria-label: "Table of contents"]
  [div = class: "ck-toc-header"]
    [span = class: "ck-toc-title"]
      [svg = xmlns: "http://www.w3.org/2000/svg", width: "14", height: "14", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round"]
        [line = x1: "3", y1: "6", x2: "21", y2: "6"!]
        [line = x1: "3", y1: "12", x2: "16", y2: "12"!]
        [line = x1: "3", y1: "18", x2: "12", y2: "18"!]
      [end:svg]
      Contents
    [end:span]
    [button = class: "ck-toc-close", id: "ck-toc-close", aria-label: "Close contents"]
      [svg = xmlns: "http://www.w3.org/2000/svg", width: "16", height: "16", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round"]
        [line = x1: "18", y1: "6", x2: "6", y2: "18"!]
        [line = x1: "6", y1: "6", x2: "18", y2: "18"!]
      [end:svg]
    [end:button]
  [end:div]
  [div = class: "ck-toc-links"]
    [for-each = ${ __csHeadings || [] }$, as: "h"]
      [a = href: ${ '#' + h.id }$, class: ${ 'ck-tl ck-tl-' + h.level }$, data-id: ${ h.id }$]${ h.text }$[end:a]
    [end:for-each]
  [end:div]
[end:nav]
