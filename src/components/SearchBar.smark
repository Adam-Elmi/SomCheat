[div = class: "sc-search"]
  [span = class: "sc-search-icon"]
    [svg = xmlns: "http://www.w3.org/2000/svg", width: "1.1em", height: "1.1em", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round"]
      [circle = cx: "11", cy: "11", r: "8"][end:circle]
      [line = x1: "21", y1: "21", x2: "16.65", y2: "16.65"][end:line]
    [end:svg]
  [end:span]
  [input = type: "text", placeholder: "Search"!]
  [button = class: "sc-search-btn"]
    [span = class: "sc-search-btn-label"]Search[end:span]
    [svg = class: "sc-search-btn-icon", xmlns: "http://www.w3.org/2000/svg", width: "16", height: "16", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2.5", stroke-linecap: "round", stroke-linejoin: "round"]
      [circle = cx: "11", cy: "11", r: "8"][end:circle]
      [line = x1: "21", y1: "21", x2: "16.65", y2: "16.65"][end:line]
    [end:svg]
  [end:button]
[end:div]
