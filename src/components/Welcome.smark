[import = Smile: "../icons/smile.smark"!]
[import = Happy: "../icons/happy.smark"!]
[import = Wink: "../icons/wink.smark"!]
[import = Rocket: "../icons/rocket.smark"!]
[import = Bulb: "../icons/bulb.smark"!]
[import = Thunder: "../icons/thunder.smark"!]
[import = Github: "../icons/github.smark"!]
[import = Docs: "../icons/docs.smark"!]

[div = class: "sc-welcome"]
  [div = class: "sc-welcome-stripe"][end:div]

  [div = class: "sc-welcome-body"]
    [div = class: "sc-welcome-msgs"]
      [div = class: "welcome-msg sc-welcome-msg"]
        [div = class: "sc-welcome-icon"][Smile!][end:div]
        [div = class: "sc-welcome-text-row"]
          [h2 = class: "sc-welcome-text"]
            Ku soo dhowow [span = class: "sc-accent"]SomCheat[end:span]! Xasuusin degdeg ah oo koodhkaaga fududeynaya.
          [end:h2]
          [span = class: "sc-welcome-emoji"][Rocket!][end:span]
        [end:div]
      [end:div]

      [div = class: "welcome-msg sc-welcome-msg"]
        [div = class: "sc-welcome-icon"][Happy!][end:div]
        [div = class: "sc-welcome-text-row"]
          [h2 = class: "sc-welcome-text"]
            Ma u baahan tahay xasuusin degdeg ah? [span = class: "sc-accent"]SomCheat[end:span] waa diyaar!
          [end:h2]
          [span = class: "sc-welcome-emoji"][Bulb!][end:span]
        [end:div]
      [end:div]

      [div = class: "welcome-msg sc-welcome-msg"]
        [div = class: "sc-welcome-icon"][Wink!][end:div]
        [div = class: "sc-welcome-text-row"]
          [h2 = class: "sc-welcome-text"]
            Koodhkaaga fududee oo xasuuso waxa muhiimka ah!
          [end:h2]
          [span = class: "sc-welcome-emoji"][Thunder!][end:span]
        [end:div]
      [end:div]
    [end:div]

    [div = class: "sc-welcome-actions"]
      [a = href: "https://github.com/Adam-Elmi/SomCheat", target: "_blank", rel: "noopener noreferrer", class: "sc-btn-ghost"]
        [span]Contribute[end:span]
        [span = fontSize: "1.1rem"][Github!][end:span]
      [end:a]
      [a = href: "https://github.com/Adam-Elmi/SomCheat/tree/master/docs", target: "_blank", rel: "noopener noreferrer", class: "sc-btn-solid"]
        [span]Read Docs[end:span]
        [span = fontSize: "1.1rem"][Docs!][end:span]
      [end:a]
    [end:div]
  [end:div]
[end:div]

