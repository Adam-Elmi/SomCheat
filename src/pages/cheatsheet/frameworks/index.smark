[import = Layout: "../../../layouts/Layout.smark" !]
[import = CategoryPage: "../../../layouts/CategoryPage.smark" !]

[Metadata = title: "Frameworks", description: "Framework cheatsheets" !]

${ globalThis.__cat = (await getCheatsheets()).find(c => c.key === "frameworks") || {name:"Frameworks",count:0,iconSvg:"",sheets:[]}}$

[Layout = title: "Frameworks Cheatsheets", description: "Framework cheatsheets"]
  [CategoryPage!]
[end:Layout]

runtime ${
  window.__somcheatIndex = SomMark.static(`(__cat.sheets||[]).map(s=>({title:s.title,iconHtml:s.iconHtml||'',url:s.url,aliases:s.aliases||[]}))`);
}$
[script = type: "module", src: "/src/scripts/search.js"][end:script]
