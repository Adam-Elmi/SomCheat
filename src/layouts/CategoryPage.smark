[import = SearchBar: "../components/SearchBar.smark" !]
[import = ProgressBar: "../icons/progressBar.smark" !]
[import = Status: "../icons/status.smark" !]
[import = Date: "../icons/date.smark" !]

[div = class: "cs-page-header"]
  [div = class: "cs-page-title-row"]
    [span = class: "sc-category-icon"]${ SomMark.raw(__cat.iconSvg) }$[end:span]
    [h1 = class: "cs-page-title"]${ __cat.name }$[end:h1]
    [span = class: "cs-page-count"]${ __cat.count }$ total[end:span]
  [end:div]
  [div = class: "cs-search-row"]
    [div = class: "sc-search-wrapper"]
      [SearchBar!]
      [div = class: "sc-search-results", id: "sc-search-results", hidden: ""][end:div]
    [end:div]
  [end:div]
[end:div]

[div = class: "sc-sheets-section"]
  [div = class: "sc-sheets-grid"]
    [for-each = ${ __cat.sheets }$, as: "sheet"]
      [a = href: ${ sheet.url }$, class: "sc-card"]

        [div = class: "sc-card-top"]
          [div = class: "sc-card-title-row"]
            [span = class: "sc-card-badge"]${ sheet.iconHtml ? SomMark.raw(sheet.iconHtml) : sheet.abbr }$[end:span]
            [span = class: "sc-card-name"]${ sheet.title }$[end:span]
          [end:div]
          [ProgressBar = color: ${ sheet.progressColor }$, dash: ${ sheet.progressDash }$, size: "24px" !]
        [end:div]

        [div = class: "sc-card-meta"]
          [Date = width: "1.5em", height: "1.5em" !]
          [span]${ sheet.formattedDate }$[end:span]
        [end:div]

        [div = class: "sc-card-bar-row"]
          [Status !]
          [div = class: "sc-card-track"]
            [div = class: "sc-card-fill", style: ${ sheet.barStyle }$][end:div]
          [end:div]
          [span = class: "sc-card-pct"]${ sheet.progress }$%[end:span]
        [end:div]

      [end:a]
    [end:for-each]
  [end:div]
[end:div]
