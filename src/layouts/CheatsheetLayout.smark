[import = InfoCard: "../components/cheatsheet/InfoCard.smark" !]
[import = Toc: "../components/cheatsheet/Toc.smark" !]

${
  globalThis.__csMeta = await getMetadata(__currentFile);
  globalThis.__csHeadings = await getHeadings(__currentFile);
  globalThis.__csCategory = (__currentUrl || '').split('/').filter(Boolean)[1] || 'other';
  globalThis.__csCheatsheets = await getCheatsheets();
  const _sheet = globalThis.__csCheatsheets.flatMap(c => c.sheets).find(s => s.url === __currentUrl);
  globalThis.__csLastUpdated = _sheet?.formattedDate || '';
  globalThis.__csIconHtml = _sheet?.iconHtml || '';
  globalThis.__csCatIcons = {
    languages:  '<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
    databases:  '<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>',
    frameworks: '<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
    libraries:  '<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
    devtools:   '<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
    runtimes:   '<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>',
    platforms:  '<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
    other:      '<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>',
  };
  void 0;
}$

[DOCTYPE!]
[html = lang: "en"]
  [head]
    [meta = charset: "UTF-8"!]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1.0"!]
    [title]${ __csMeta?.title || 'Cheatsheet' }$ — SomCheat[end]
    [meta = name: "description", content: ${ __csMeta?.intro || ('SomCheat — ' + (__csMeta?.title || 'Cheatsheet')) }$!]
    [link = rel: "icon", href: "/src/assets/som.svg", type: "image/svg+xml"!]
    [script= smark-raw: true, smark-syntax: js]document.documentElement.classList.add('no-transition');window.addEventListener('load',function(){requestAnimationFrame(function(){document.documentElement.classList.remove('no-transition')})},{once:true})[end:script]
    [style = smark-raw:true, smark-syntax: css]
:root {
  --ck-bg: #f8fafc;
  --ck-text: #0f172a;
}
[data-theme="dark"] {
  --ck-bg: #101012;
  --ck-text: #e6edf3;
}
html,
body {
  background: var(--ck-bg);
  color: var(--ck-text);
  margin: 0;
}
html.no-transition * {
  transition: none !important;
}[end:style]
    [link = rel: "stylesheet", href: "/src/styles/cheatsheet.css"!]
    [link = rel: "preconnect", href: "https://fonts.googleapis.com"!]
    [link = rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: ""!]
    [link = rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Grand+Hotel&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"!]
  [end]

  [body = class: "ck-body"]

    [header = class: "ck-header"]
      [a = href: "/", class: "ck-header-logo"]
        [svg = xmlns: "http://www.w3.org/2000/svg", width: "16", height: "16", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round"]
          [polyline = points: "15 18 9 12 15 6"!]
        [end:svg]
        SomCheat
      [end:a]
      [div = class: "ck-header-right"]
        [button = class: "ck-nav-btn", id: "ck-nav-btn", aria-label: "All cheatsheets"]
          [svg = xmlns: "http://www.w3.org/2000/svg", width: "1.5em", height: "1.5em", viewBox: "0 0 256 256"]
            [path = d: "M0 0h256v256H0z", fill: "none"!]
            [path = fill: "currentColor", d: "M216 44H40a12 12 0 0 0-12 12v144a12 12 0 0 0 12 12h176a12 12 0 0 0 12-12V56a12 12 0 0 0-12-12M36 200v-52h20a4 4 0 0 0 0-8H36v-24h20a4 4 0 0 0 0-8H36V84h20a4 4 0 0 0 0-8H36V56a4 4 0 0 1 4-4h44v152H40a4 4 0 0 1-4-4m184 0a4 4 0 0 1-4 4H92V52h124a4 4 0 0 1 4 4Z"!]
          [end:svg]
        [end:button]
        [button = class: "ck-contents-btn", id: "ck-contents-btn", aria-label: "Table of contents"]
          [svg = xmlns: "http://www.w3.org/2000/svg", width: "15", height: "15", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round"]
            [line = x1: "3", y1: "6", x2: "21", y2: "6"!]
            [line = x1: "3", y1: "12", x2: "16", y2: "12"!]
            [line = x1: "3", y1: "18", x2: "12", y2: "18"!]
          [end:svg]
          [span]Contents[end:span]
        [end:button]
        [button = class: "ck-theme-btn", id: "ck-theme-btn", aria-label: "Toggle theme"]
          [svg = class: "ck-icon-sun", xmlns: "http://www.w3.org/2000/svg", width: "17", height: "17", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round"]
            [circle = cx: "12", cy: "12", r: "5"!]
            [line = x1: "12", y1: "1", x2: "12", y2: "3"!][line = x1: "12", y1: "21", x2: "12", y2: "23"!]
            [line = x1: "4.22", y1: "4.22", x2: "5.64", y2: "5.64"!][line = x1: "18.36", y1: "18.36", x2: "19.78", y2: "19.78"!]
            [line = x1: "1", y1: "12", x2: "3", y2: "12"!][line = x1: "21", y1: "12", x2: "23", y2: "12"!]
            [line = x1: "4.22", y1: "19.78", x2: "5.64", y2: "18.36"!][line = x1: "18.36", y1: "5.64", x2: "19.78", y2: "4.22"!]
          [end:svg]
          [svg = class: "ck-icon-moon", xmlns: "http://www.w3.org/2000/svg", width: "17", height: "17", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round"]
            [path = d: "M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"!]
          [end:svg]
        [end:button]
      [end:div]
    [end:header]

    [div = class: "ck-shell"]
      [nav = class: "ck-sidenav"]
        [div = class: "ck-sidenav-header"]
          [span]Cheatsheets[end:span]
          [button = class: "ck-nav-close", id: "ck-nav-close", aria-label: "Close navigation"]
            [svg = xmlns: "http://www.w3.org/2000/svg", width: "18", height: "18", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round"]
              [line = x1: "18", y1: "6", x2: "6", y2: "18"!]
              [line = x1: "6", y1: "6", x2: "18", y2: "18"!]
            [end:svg]
          [end:button]
        [end:div]
        [div = class: "ck-sidenav-search-wrap"]
          [svg = xmlns: "http://www.w3.org/2000/svg", width: "14", height: "14", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round", class: "ck-sidenav-search-icon"]
            [circle = cx: "11", cy: "11", r: "8"!]
            [line = x1: "21", y1: "21", x2: "16.65", y2: "16.65"!]
          [end:svg]
          [input = type: "text", id: "ck-nav-search", class: "ck-sidenav-search-input", placeholder: "Search cheatsheets..."!]
        [end:div]
        [for-each = ${ __csCheatsheets || [] }$, as: "cat"]
          [div = class: "ck-sidenav-group"]
            ${ SomMark.raw('<span class="ck-sidenav-cat">' + (__csCatIcons[cat.key] || __csCatIcons.other) + cat.name + '</span>') }$
            [for-each = ${ cat.sheets }$, as: "sheet"]
              [a = href: ${ sheet.url }$, class: ${ sheet.url === __currentUrl ? 'ck-sidenav-link is-current' : 'ck-sidenav-link' }$, data-aliases: ${ (sheet.aliases || []).join(',') }$]
                ${ sheet.iconHtml
                    ? SomMark.raw('<span class="ck-sidenav-icon">' + sheet.iconHtml + '</span>')
                    : SomMark.raw('<span class="ck-sidenav-icon ck-sidenav-icon--fallback">' + (sheet.title || '?').slice(0, 2) + '</span>') }$
                [span = class: "ck-sidenav-name"]${ sheet.title }$[end:span]
              [end:a]
            [end:for-each]
          [end:div]
          [hr = color: --ck-border !]
        [end:for-each]
      [end:nav]

      [div = class: "ck-wrap"]
        [div = class: "ck-main"]
          [InfoCard!]
          [div = class: "ck-content"]
            [slot][end]
          [end:div]
        [end:div]
        [Toc!]
      [end:div]
    [end:div]

    [div = class: "ck-toc-backdrop", id: "ck-toc-backdrop"][end:div]
    [div = class: "ck-nav-backdrop", id: "ck-nav-backdrop"][end:div]

    runtime ${
    // SomMark.static('true') -> true
      window.__ckReady = true;
    }$
    [script = type: "module", src: "/src/scripts/cheatsheet.js"][end:script]
  [end]
[end]
